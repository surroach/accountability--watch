# Accountability Watch - Environment Configuration Template
# Copy this to .env and fill in your actual values
# IMPORTANT: .env is GITIGNORED - never commit secrets

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Supabase project ID (visible)
SUPABASE_PROJECT_ID="your-project-id-here"

# Supabase URL (visible)
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon Key (public, used by browser)
# Get from: Supabase Dashboard → Settings → API → Anon public
SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# Supabase Service Role Key (SECRET - server-only)
# Get from: Supabase Dashboard → Settings → API → Service role
# NEVER expose this in browser code
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# ============================================================================
# VITE FRONTEND VARIABLES
# These are exposed to the browser (use VITE_ prefix)
# ============================================================================

# Frontend uses these with import.meta.env.VITE_*
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Quick exit button destination (safe URL)
# Users click "Quick Exit" to immediately navigate here
VITE_QUICK_EXIT_URL="https://www.wikipedia.org"

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit .env to git
# 2. Keep .env in .gitignore (it's configured)
# 3. For production, use .env.production
# 4. Get keys from your Supabase project dashboard
# 5. Rotate keys monthly for security

