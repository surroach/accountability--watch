# Accountability Watch - Environment Configuration Example
# Copy this file to .env and fill in actual values

# ============================================================================
# Optional: Backend Service (for legal partner authentication)
# Leave blank to use local SQLite only
# ============================================================================

# Supabase Project ID
# Get from: https://app.supabase.com/projects
SUPABASE_PROJECT_ID=your_project_id

# Supabase Publishable Key (Safe to commit - frontend use only)
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Supabase Service Role Key (SECRET - do NOT commit this)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase URL
SUPABASE_URL=https://your_project.supabase.co

# ============================================================================
# Frontend Configuration (Vite)
# ============================================================================

# Same as above for frontend
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://your_project.supabase.co

# Quick Exit URL - Where "Emergency Exit" button links to
# Default: Wikipedia (innocuous site)
VITE_QUICK_EXIT_URL=https://www.wikipedia.org

# ============================================================================
# Development Only
# ============================================================================

# Node environment
NODE_ENV=development

# ============================================================================
# Notes
# ============================================================================
# - For local development, leave Supabase variables blank
# - SQLite database is stored locally (db/ folder)
# - Never commit .env file with real credentials
# - .env is in .gitignore by default
# - Use .env.local for local-only overrides
